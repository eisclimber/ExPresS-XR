  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"Kyudo, the Way of the Bow, shares much in common with the Japanese\r\n
    tea ceremony (cbado), calligraphy (sbodo), swordsmanship (iaido), and\r\n the
    various other Ways which so effectively mirror the heart and mind\r\n of the
    Japanese. Kyudo is rich in history and tradition and is highly\r\n regarded in
    Japan. Many consider it to be one of the purest of all budo\r\n (martial ways).
    In the past, the bow was used for a variety of purposes:\r\n hunting, war, court
    games and rituals, religious ceremonies, and contests\r\n of skill. Many of these
    games and rituals survive to this day, but the\r\n Japanese bow long ago lost
    its practical value as a weapon. Today,\r\n kyudo is practiced primarily as a
    method of physical, moral, and\r\n spiritual development.\""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
